<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- iOS seulement (l'appli Android vit dans sonnuage-android). La lecture passe par la webview (WebPlayer de
       SonNuage.UI, audio HTML + MediaSession), comme l'appli de bureau. Le build CI produit un .app non signé, empaqueté
       en .ipa : il se signe ensuite avec un Apple ID gratuit (Sideloadly, AltStore) ou un compte développeur.
       Voir docs/IOS.md. Il exige macOS (Xcode) et le workload maui-ios. -->
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>SonNuage.Mobile</RootNamespace>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <ApplicationTitle>SonNuage</ApplicationTitle>
    <ApplicationId>org.pmjb.sonnuage</ApplicationId>
    <!-- CFBundleShortVersionString n'accepte que x.y.z : sans le suffixe -ci.N des builds de main. -->
    <ApplicationDisplayVersion>$(Version.Split('-')[0])</ApplicationDisplayVersion>
    <!-- Surchargé par la CI (-p:ApplicationVersion=numéro du run) : doit croître à chaque build installé. -->
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Les DTO sont (dé)sérialisés par réflexion : on ne rogne que le framework. -->
    <TrimMode>partial</TrimMode>

    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">ios-arm64</RuntimeIdentifier>
    <CodesignEntitlements>Platforms/iOS/Entitlements.plist</CodesignEntitlements>
    <MtouchLink>SdkOnly</MtouchLink>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.62" Color="#141a33" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#141a33" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
  </ItemGroup>

  <!-- Pages et composants partagés avec le client web : sources du dépôt sonnuage s'il est cloné à côté (développement),
       sinon paquet NuGet publié par sa CI (version dans Directory.Packages.props). -->
  <ItemGroup Condition="Exists('$(SonNuageUiProject)')">
    <ProjectReference Include="$(SonNuageUiProject)" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(SonNuageUiProject)')">
    <PackageReference Include="SonNuage.UI" />
  </ItemGroup>

</Project>
